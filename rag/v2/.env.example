# ── PostgreSQL (pgvector) — main DB ──────────────────────────────────────────
DATABASE_URL=postgresql://ragv2:changeme@localhost:7300/ragv2?sslmode=disable

# ── Apache AGE — graph DB ─────────────────────────────────────────────────────
AGE_DATABASE_URL=postgresql://age:changeme@localhost:7400/age_graph?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM (Ollama local — default) ──────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_NUM_CTX=8192

# ── Embeddings (Ollama local) ─────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_DIMENSION=768

# ── Model tiers ───────────────────────────────────────────────────────────────
MODEL_TIER_NANO=qwen2.5:0.5b
MODEL_TIER_SMALL=llama3.2:3b
MODEL_TIER_LARGE=llama3.1:70b
MODEL_ROUTING_ENABLED=false

# ── VLM (for docling PDF image description, optional) ────────────────────────
VLM_ENABLED=false

# ── JWT auth ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=infra/keys/public.pem

# ── Semantic cache (L3) ───────────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=false

# ── Confidence thresholds ─────────────────────────────────────────────────────
MIN_CONFIDENCE_SCORE=0.10
CONFIDENCE_WARN_THRESHOLD=0.40
RETRIEVAL_CONFIDENCE_THRESHOLD=0.0
JUDGE_CONFIDENCE_THRESHOLD=0.60
JUDGE_K=10

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false

# ── Cost circuit breaker ──────────────────────────────────────────────────────
SYSTEM_DAILY_COST_LIMIT_USD=0.0
CLOUD_MODELS_ENABLED=false

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_EMAIL=alerts@example.com

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_ENABLED=false

# ── Mem0 user memory ─────────────────────────────────────────────────────────
MEM0_ENABLED=false

# ── Corpus (JSON array of CorpusConfig objects) ───────────────────────────────
CORPUS_CONFIGS_JSON=[]
