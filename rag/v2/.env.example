# ── PostgreSQL (pgvector) — main DB ──────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://ragv2:changeme@localhost:5432/ragv2

# ── Apache AGE — graph DB (separate container, port 5433) ────────────────────
AGE_DB_PASSWORD=changeme
AGE_DATABASE_URL=postgresql://age:changeme@localhost:5433/age_graph
AGE_GRAPH_PREFIX=kg

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=20

# ── LLM (Ollama local — default) ──────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_NUM_CTX=8192

# ── Embeddings (Ollama local) ─────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_DIMENSION=768

# ── Model tiers ───────────────────────────────────────────────────────────────
MODEL_TIER_NANO=qwen2.5:0.5b
MODEL_TIER_SMALL=llama3.2:3b
MODEL_TIER_LARGE=llama3.1:70b
MODEL_ROUTING_ENABLED=true
MODEL_ROUTING_TIMEOUT_S=3.0

# ── VLM (for docling PDF image description, optional) ────────────────────────
VLM_ENABLED=false
VLM_MODEL=qwen2.5vl:7b
VLM_BASE_URL=http://localhost:11434/v1
VLM_TIMEOUT=120.0
VLM_CONCURRENCY=1

# ── JWT auth ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
# Path to RSA public key PEM file (relative to backend/ or absolute)
JWT_PUBLIC_KEY_PATH=infra/keys/public.pem
JWKS_CACHE_TTL_S=3600

# ── JWE payload encryption ────────────────────────────────────────────────────
JWE_ALGORITHM=ECDH-ES+A256KW
JWE_CONTENT_ENCRYPTION=A256GCM
# Per-tenant JWE keys loaded from this directory at startup (local dev only)
JWE_KEYS_DIR=infra/keys/jwe

# ── Semantic cache (L3) ───────────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_MINUTES=60
SEMANTIC_CACHE_MAX_ROWS=10000

# ── Worker / ingestion ────────────────────────────────────────────────────────
INGEST_WORKER_CONCURRENCY=2
RETRIEVAL_WORKER_CONCURRENCY=2
MAX_RETRIES=3
JOB_TIMEOUT_S=300
GRAPH_EXTRACTION_TIMEOUT_S=120.0
CHUNK_MAX_TOKENS=512

# ── Confidence thresholds ─────────────────────────────────────────────────────
MIN_CONFIDENCE_SCORE=0.10
CONFIDENCE_WARN_THRESHOLD=0.40
RETRIEVAL_CONFIDENCE_THRESHOLD=1.5
JUDGE_CONFIDENCE_THRESHOLD=0.60
JUDGE_K=5

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_MAX_CONCURRENT_JOBS=5

# ── Cost circuit breaker ──────────────────────────────────────────────────────
SYSTEM_DAILY_COST_LIMIT_USD=0.0
# 0.0 = disabled (no cloud models by default)
CLOUD_MODELS_ENABLED=false

# ── Alerts (email ALL warnings/errors to this address) ───────────────────────
ALERT_EMAIL=rohan.vazirani@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@rag-system.local

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ── Mem0 user memory ─────────────────────────────────────────────────────────
MEM0_ENABLED=false

# ── Corpus (JSON array of CorpusConfig objects) ───────────────────────────────
# CORPUS_CONFIGS_JSON=[{"id":"default","display_name":"Default","source_folders":["../rag/documents"],"allowed_roles":["reader"],"metadata_tags":{}}]
CORPUS_CONFIGS_JSON=[]

# ── API rate limiting ─────────────────────────────────────────────────────────
API_RATE_LIMIT_RPM=60
API_RATE_LIMIT_BURST=10
MAX_QUERY_CHARS=4096
MAX_PROMPT_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
